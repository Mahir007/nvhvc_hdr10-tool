<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Embedded in nvhvc.exe by build.rs. On Windows 11 24H2 and later, consoleAllocationPolicy stops
     Windows opening a console window when the exe starts from Explorer, the Start menu or a
     shortcut. Started from a terminal, it still uses the terminal's console. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <consoleAllocationPolicy xmlns="http://schemas.microsoft.com/SMI/2024/WindowsSettings">detached</consoleAllocationPolicy>
    </windowsSettings>
  </application>
</assembly>
